// UML class diagram of Bug Catcher (project-3).
// Regenerate with: dot -Tsvg uml.dot -o uml.svg   (build.sh does it)
digraph BugCatcher {
    graph [rankdir=BT, nodesep=0.35, ranksep=0.55, fontname="DejaVu Sans", bgcolor="white"];
    node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
    edge  [fontname="DejaVu Sans", fontsize=9];

    GameApplication [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eeeeee">
        <tr><td><i>«FXGL»</i><br/><b>GameApplication</b></td></tr>
        </table>>];

    BugCatcherApp [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#e8f5ee">
        <tr><td><b>BugCatcherApp</b></td></tr>
        <tr><td align="left" balign="left" sides="t">- player : Player<br/>- highScores : HighScores<br/>- basket : Entity<br/>- gameOver : boolean</td></tr>
        <tr><td align="left" balign="left" sides="t"><u>+ main(args : String[])</u><br/># initSettings(GameSettings)<br/># initInput()<br/># initGame()<br/># initPhysics()<br/># initUI()<br/># onUpdate(tpf : double)<br/>- spawnItem()<br/>- endGame()</td></tr>
        </table>>];

    Catchable [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff6e0">
        <tr><td><i>«interface»</i><br/><b>Catchable</b></td></tr>
        <tr><td align="left" sides="t">+ onCaught(Player)</td></tr>
        </table>>];

    Scorable [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff6e0">
        <tr><td><i>«interface»</i><br/><b>Scorable</b></td></tr>
        <tr><td align="left" sides="t"><u>+ BASE_POINTS : int = 10</u></td></tr>
        <tr><td align="left" sides="t">+ getPoints() : int</td></tr>
        </table>>];

    Dangerous [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff6e0">
        <tr><td><i>«interface»</i><br/><b>Dangerous</b></td></tr>
        <tr><td align="left" sides="t">+ getDamage() : int</td></tr>
        </table>>];

    FallingItem [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><i>«abstract»</i><br/><b><i>FallingItem</i></b></td></tr>
        <tr><td align="left" balign="left" sides="t"><u>+ SIZE : double</u><br/><u>- createdCount : int</u><br/>- name : String<br/># speed : double</td></tr>
        <tr><td align="left" balign="left" sides="t">+ getSpeed() : double<br/><u>+ getCreatedCount() : int</u><br/>+ createShape() : Circle  {final}<br/>+ createLabel() : Text  {final}<br/><i># getColor() : Color</i><br/><i># getLabel() : String</i><br/><i>+ onCaught(Player)</i></td></tr>
        </table>>];

    Coffee [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><b>Coffee</b></td></tr>
        <tr><td align="left" balign="left" sides="t">+ getPoints() : int<br/>+ onCaught(Player)</td></tr>
        </table>>];

    GoldenCoffee [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><b>GoldenCoffee</b></td></tr>
        <tr><td align="left" sides="t">+ getPoints() : int</td></tr>
        </table>>];

    Bug [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><b>Bug</b></td></tr>
        <tr><td align="left" balign="left" sides="t">+ getDamage() : int<br/>+ onCaught(Player)</td></tr>
        </table>>];

    Heart [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><i>«final»</i><br/><b>Heart</b></td></tr>
        <tr><td align="left" sides="t">+ onCaught(Player)</td></tr>
        </table>>];

    ItemFactory [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#ffffff">
        <tr><td><i>«final»</i><br/><b>ItemFactory</b></td></tr>
        <tr><td align="left" balign="left" sides="t"><u>+ randomItem(level : int) : FallingItem</u><br/><u>+ randomItem(level : int, roll : int) : FallingItem</u></td></tr>
        </table>>];

    Player [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#e8f0fb">
        <tr><td><b>Player</b></td></tr>
        <tr><td align="left" balign="left" sides="t">- name : String<br/>- score : int<br/>- lives : int<br/>- caughtItems : ArrayList&lt;FallingItem&gt;</td></tr>
        <tr><td align="left" balign="left" sides="t">+ caught(FallingItem)<br/>+ addPoints(int)<br/>+ loseLife(int)<br/>+ gainLife()<br/>+ setLives(int)<br/>+ getLevel() : int<br/>+ getSummary() : String</td></tr>
        </table>>];

    HighScores [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#e8f0fb">
        <tr><td><b>HighScores</b></td></tr>
        <tr><td align="left" balign="left" sides="t"><u>+ SIZE : int = 5</u><br/>- scores : int[]</td></tr>
        <tr><td align="left" balign="left" sides="t">+ add(int) : boolean<br/>+ contains(int) : boolean<br/>+ getBest() : int<br/>+ save()</td></tr>
        </table>>];

    // Inheritance (solid line, hollow triangle)
    edge [arrowhead=empty, style=solid];
    BugCatcherApp -> GameApplication;
    Coffee -> FallingItem;
    Bug -> FallingItem;
    Heart -> FallingItem;
    GoldenCoffee -> Coffee;
    Dangerous -> Catchable;

    // Interface realization (dashed line, hollow triangle)
    edge [arrowhead=empty, style=dashed];
    FallingItem -> Catchable;
    Coffee -> Scorable;
    Bug -> Dangerous;

    // Composition (filled diamond on the owner's side)
    edge [arrowhead=diamond, style=solid];
    Player -> BugCatcherApp;
    HighScores -> BugCatcherApp;

    // Aggregation (hollow diamond): Player keeps a list of caught items
    edge [arrowhead=odiamond, style=solid];
    FallingItem -> Player [taillabel="*", label=" caughtItems"];

    // Dependency (dashed, open arrow)
    edge [dir=forward, arrowhead=vee, style=dashed, arrowtail=none];
    BugCatcherApp -> ItemFactory [label=" uses"];
    ItemFactory -> FallingItem [label=" creates"];
}
